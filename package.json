{
  "name": "cosense-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "type": "module",
  "dependencies": {
    "@helpfeel/cosense-cli": "1.14.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "scripts": {
    "build": "pnpm run contract && tsc -p tsconfig.build.json",
    "contract": "tsx scripts/generate-contract.ts",
    "dev": "pnpm run contract && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix:prettier": "prettier --write src scripts vitest.config.ts",
    "fix": "pnpm run fix:prettier",
    "lint:prettier": "prettier --check src scripts vitest.config.ts",
    "lint": "pnpm run lint:prettier",
    "test": "pnpm run contract && vitest run",
    "test:watch": "pnpm run contract && vitest",
    "type-check": "pnpm run contract && tsc --noEmit"
  }
}
