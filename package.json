{
  "name": "cosense-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module",
  "dependencies": {
    "@helpfeel/cosense-cli": "1.17.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "pnpm run contract && tsc -p tsconfig.build.json",
    "contract": "tsx scripts/generate-contract.ts",
    "dev": "pnpm run contract && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix:prettier": "prettier --write src scripts vitest.config.ts",
    "fix": "pnpm run fix:prettier",
    "lint:prettier": "prettier --check src scripts vitest.config.ts",
    "lint": "pnpm run lint:prettier",
    "test": "pnpm run contract && vitest run",
    "test:watch": "pnpm run contract && vitest",
    "type-check": "pnpm run contract && tsc --noEmit"
  }
}
