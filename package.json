{
  "name": "cosense-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "type": "module",
  "dependencies": {
    "@helpfeel/cosense-cli": "1.14.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "jose": "6.2.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build": "pnpm run contract && tsc -p tsconfig.build.json",
    "contract": "tsx scripts/generate-contract.ts",
    "dev": "pnpm run contract && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix:prettier": "prettier --write src scripts vitest.config.ts",
    "fix": "pnpm run fix:prettier",
    "lint:prettier": "prettier --check src scripts vitest.config.ts",
    "lint": "pnpm run lint:prettier",
    "test": "pnpm run contract && vitest run",
    "test:watch": "pnpm run contract && vitest",
    "type-check": "pnpm run contract && tsc --noEmit"
  }
}
