{
  "name": "cosense-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "type": "module",
  "dependencies": {
    "@helpfeel/cosense-cli": "1.17.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "pnpm run contract && tsc -p tsconfig.build.json",
    "contract": "tsx scripts/generate-contract.ts",
    "dev": "pnpm run contract && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix:prettier": "prettier --write src scripts vitest.config.ts",
    "fix": "pnpm run fix:prettier",
    "lint:prettier": "prettier --check src scripts vitest.config.ts",
    "lint": "pnpm run lint:prettier",
    "test": "pnpm run contract && vitest run",
    "test:watch": "pnpm run contract && vitest",
    "type-check": "pnpm run contract && tsc --noEmit"
  }
}
