{
  "name": "cosense-cli-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "type": "module",
  "dependencies": {
    "@helpfeel/cosense-cli": "1.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "scripts": {
    "build": "pnpm run contract && tsc -p tsconfig.build.json",
    "contract": "tsx scripts/generate-contract.ts",
    "dev": "pnpm run contract && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix:prettier": "prettier --write src scripts vitest.config.ts",
    "fix": "pnpm run fix:prettier",
    "lint:prettier": "prettier --check src scripts vitest.config.ts",
    "lint": "pnpm run lint:prettier",
    "test": "pnpm run contract && vitest run",
    "test:watch": "pnpm run contract && vitest",
    "type-check": "pnpm run contract && tsc --noEmit"
  }
}
